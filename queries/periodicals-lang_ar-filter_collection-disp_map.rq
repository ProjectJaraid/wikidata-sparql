#title: الصحافة العربية موجودة في ارشيف الشارخ
#defaultView:Map
PREFIX medium: <http://www.wikidata.org/entity/Q1002697> # set a publication type: periodicals (wd:Q1002697), newspapers (wd:Q11032)
PREFIX collection: <http://www.wikidata.org/entity/Q124855340> # ارشيف الشارخ
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX schema: <http://schema.org/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
# get all periodicals in given languages
WITH %periodicals AS {
  # select publication languages
  VALUES ?lang {
    wd:Q13955 # Arabic
  # wd:Q36730 # Ottoman Turkish
  # wd:Q8785 # Armenian
  # wd:Q36155 # Coptic
  # wd:Q9129 # Greek
  # wd:Q9168 # Farsi
  # wd:Q36196 # Ladino
    }.
  ?periodical wdt:P31/wdt:P279* medium: ; # limit to medium
             (wdt:P571 | wdt:P580) ?dateOnset ;
              wdt:P407/wdt:P279* ?lang ; # limit by publication language
            wdt:P195 collection: . # limit to holding
}
SELECT DISTINCT
  ?periodical ?periodicalLabel (YEAR(?dateOnset) AS ?year)
  ?coords
  WHERE {
   # include results of named subqueries
   { SELECT DISTINCT ?periodical ?dateOnset WHERE { INCLUDE %periodicals } }
   # retrieve more properties: locations
    OPTIONAL {
      ?periodical (wdt:P291|wdt:P159|wdt:P276 ) ?pubPlace .
      ?pubPlace wdt:P625 ?coords .
    }
  # labels are more tricky!
  OPTIONAL {?periodical rdfs:label ?periodical_label_value .
             FILTER (lang(?periodical_label_value) = "ar")}
  # get title in publication language
    OPTIONAL {?periodical wdt:P1476 ?title ;
                        wdt:P407/wdt:P218 ?pubLang .} # Only works with ISO 639-1 code (P218)
  BIND(
    if(
      langMatches(lang(?title), ?pubLang),
    str(?title),
    if(
      bound(?periodical_label_value),
      ?periodical_label_value,
      str(?periodical)
      )
    ) AS ?periodicalLabel)
}
ORDER BY ?dateOnset
LIMIT 2000